---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3 }}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
          {% assign profile_image_alt = page.profile.image_alt | default: page.profile.image %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile_image_alt
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit"> Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Industry Experience -->
    {% if page.industry_experience %}
      <h2>Industry Experience</h2>
      <div class="industry-experience">
        {% for experience in site.data.experience %}
          <div class="experience-item">
            <div class="experience-header">
              <h4 class="experience-title">{{ experience.title }}</h4>
              <span class="experience-period">{{ experience.period }}</span>
            </div>
            <div class="experience-details">
              <p class="experience-company">
                <strong>{{ experience.company }}</strong>
                {%- if experience.location %} · {{ experience.location }}{% endif %}
              </p>
              {% if experience.description %}
                <p class="experience-description">{{ experience.description }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Teaching Experience -->
    {% if page.teaching_experience %}
      <h2>Teaching Experience</h2>
      <div class="teaching-experience">
        {% for experience in site.data.teaching %}
          <div class="teaching-item">
            <div class="teaching-header">
              <h4 class="teaching-title">{{ experience.title }}</h4>
              <span class="teaching-period">{{ experience.period }}</span>
            </div>
            <div class="teaching-details">
              <p class="teaching-role">
                <strong>{{ experience.role }}</strong> {{ experience.institution }}
              </p>
              {% if experience.description %}
                <p class="teaching-description">{{ experience.description }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Service -->
    {% if page.service %}
      <h2>Service</h2>
      <div class="service-experience">
        {% for service in site.data.service %}
          <div class="service-item">
            <div class="service-header">
              <h4 class="service-title">{{ service.conference }}</h4>
              <span class="service-year">{{ service.year }}</span>
            </div>
            <div class="service-details">
              <p class="service-role">{{ service.role }}</p>
              {% if service.description %}
                <p class="service-description">{{ service.description }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Talks & Presentations -->
    {% if page.talks %}
      <h2>Talks &amp; Presentations</h2>
      <div class="talks-section">
        {% for talk in site.data.talks %}
          <div class="talk-item">
            <div class="talk-header">
              <h4 class="talk-title">{{ talk.title }}</h4>
              <span class="talk-date">{{ talk.date }}</span>
            </div>
            <div class="talk-details">
              {% for type in talk.types %}
                <span class="talk-type">{{ type }}</span>
              {% endfor %}
              <span class="talk-venue">
                <strong>{{ talk.venue }}</strong>
                {%- if talk.location %} · {{ talk.location }}{% endif %}
              </span>
              {% for link in talk.links %}
                {% if link.url contains '://' %}
                  {% assign link_url = link.url %}
                {% else %}
                  {% assign link_url = link.url | prepend: '/assets/pdf/' | relative_url %}
                {% endif %}
                <a class="talk-link" href="{{ link_url }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-file-pdf"></i> {{ link.label }}</a>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Fun Stuff -->
    {% if page.fun_stuff %}
      <h2>Fun Facts</h2>
      <div class="fun-stuff-section">
        <p>
          {% for item in site.data.fun_stuff %}
            {% if item.description %}
              {{ item.description -}}
              {%- unless forloop.last %} {% endunless %}
            {% endif %}
          {% endfor %}
        </p>
      </div>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
